{
  "name": "@aqian0/dsh-unity",
  "version": "0.1.0",
  "description": "Unity game-development, monetization, and performance skills for DeepSeek Harness: 34 skills that load on demand, packaged as a DSH bundle.",
  "keywords": [
    "dsh-plugin",
    "game-development",
    "gamedev",
    "unity"
  ],
  "homepage": "https://github.com/AQian0/dsh-unity#readme",
  "bugs": {
    "url": "https://github.com/AQian0/dsh-unity/issues"
  },
  "license": "(MIT AND ISC AND LicenseRef-Unity-Companion-License)",
  "author": "AQian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AQian0/dsh-unity.git"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "skills/**",
    "icon.svg",
    "LICENSE.md",
    "LICENSE-UNITY-COMPANION.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "README.md",
    "docs/design.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepack": "pnpm run clean && pnpm run build",
    "prepublishOnly": "pnpm test && pnpm run validate",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "check": "vp check --deny-warnings",
    "check:fix": "vp check --fix",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='lib/**' \"test/**/*.test.ts\"",
    "test": "pnpm run check && pnpm run typecheck && pnpm run test:unit",
    "validate": "node scripts/validate-skills.ts",
    "upstream:check": "node scripts/upstream.ts --check",
    "upstream:fetch": "node scripts/upstream.ts --fetch",
    "upstream:lock": "node scripts/upstream.ts --write-lock"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "js-yaml": "4.3.2",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <1.0.0",
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
