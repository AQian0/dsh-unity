{
  "name": "@aqian0/dsh-unity",
  "version": "0.1.0",
  "description": "Unity game-development, monetization, and performance skills for DeepSeek Harness: 34 skills that load on demand, packaged as a DSH bundle.",
  "keywords": [
    "dsh-plugin",
    "unity",
    "gamedev",
    "game-development"
  ],
  "license": "(MIT AND ISC AND LicenseRef-Unity-Companion-License)",
  "author": "AQian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AQian0/dsh-unity.git"
  },
  "homepage": "https://github.com/AQian0/dsh-unity#readme",
  "bugs": {
    "url": "https://github.com/AQian0/dsh-unity/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "skills/**",
    "icon.svg",
    "LICENSE.md",
    "LICENSE-UNITY-COMPANION.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "README.md",
    "docs/design.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run validate",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate": "node scripts/validate-skills.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
