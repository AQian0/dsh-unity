{
  "name": "@aqian0/dsh-unity",
  "version": "0.1.0",
  "description": "Unity's curated game-development, monetization, and performance skills for DeepSeek Harness: 34 skills that load on demand, maintained in this package.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "unity",
    "gamedev",
    "game-development",
    "skills",
    "ui-toolkit",
    "ugui",
    "in-app-purchases",
    "multiplayer",
    "shader-graph"
  ],
  "license": "LicenseRef-Unity-Companion-License",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "skills/**",
    "icon.svg",
    "LICENSE.md",
    "README.md",
    "docs/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate": "node scripts/validate-skills.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "types": "lib/types/index.d.ts",
  "engines": {
    "node": ">=22.6"
  }
}
